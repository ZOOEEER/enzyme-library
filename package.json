{
  "name": "enzyme-library",
  "version": "0.1.0",
  "description": "Enzyme library standalone data entry and validation tool",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZOOEEER/enzyme-library.git"
  },
  "main": "dist-electron/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5288 && npm run electron:watch\"",
    "build:electron": "tsc -p electron/tsconfig.json",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "ocsr:install": "pixi install && pixi run ocsr-install",
    "ocsr:check": "pixi run ocsr-check",
    "ocsr:prepare-runtime": "node scripts/prepare-ocsr-runtime.js",
    "package": "npm run build && npm run ocsr:prepare-runtime && electron-builder --win nsis",
    "electron:watch": "nodemon --watch electron --watch app/shared --ext ts --exec \"npm run build:electron && electron .\""
  },
  "dependencies": {
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^11.10.0",
    "electron-is-dev": "^3.0.1",
    "ketcher-core": "^3.12.0",
    "ketcher-react": "^3.12.0",
    "ketcher-standalone": "^3.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smiles-drawer": "^2.1.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "cn.enzyme.library",
    "productName": "Enzyme Library",
    "files": [
      "dist/**",
      "dist-electron/**",
      "docs/**",
      "data_spec/enzyme_library_template.xlsx",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app/backend/ocsr",
        "to": "app/backend/ocsr",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/ocsr-runtime",
        "to": "ocsr-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
